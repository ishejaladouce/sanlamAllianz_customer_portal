# Copy this file to .env and adjust values for your machine.
# Only variables starting with VITE_ are available in the browser.

# Backend API base URL (used when you connect a real API)
# Leave as /api if you are running the demo with mock data only.
VITE_API_URL=/api

# WhatsApp support number in international format, no + or spaces
# Example: 250788305000
VITE_WHATSAPP_NUMBER=250788305000
